{
  "core": {
    "workingDir": ".reg",
    "actualDir": "__screenshots__",
    "thresholdRate": 0.0001
  },
  "plugins": {
    "reg-keygen-git-hash-plugin": true,
    "reg-publish-github-plugin": {
      "backend": "releases",
      "tagName": "reg-snapshots",
      "retentionDays": 30,
      "retentionCount": 10
    },
    "reg-notify-github-plugin": {
      "clientId": "${REG_NOTIFY_CLIENT_ID}",
      "prComment": true,
      "setCommitStatus": true
    }
  }
}
